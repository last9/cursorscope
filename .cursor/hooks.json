{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": ".cursor/hooks/forward.sh sessionStart" }],
    "sessionEnd": [{ "command": ".cursor/hooks/forward.sh sessionEnd" }],
    "beforeSubmitPrompt": [{ "command": ".cursor/hooks/forward.sh beforeSubmitPrompt" }],
    "preToolUse": [{ "command": ".cursor/hooks/forward.sh preToolUse" }],
    "postToolUse": [{ "command": ".cursor/hooks/forward.sh postToolUse" }],
    "postToolUseFailure": [{ "command": ".cursor/hooks/forward.sh postToolUseFailure" }],
    "beforeShellExecution": [{ "command": ".cursor/hooks/forward.sh beforeShellExecution" }],
    "afterShellExecution": [{ "command": ".cursor/hooks/forward.sh afterShellExecution" }],
    "beforeMCPExecution": [{ "command": ".cursor/hooks/forward.sh beforeMCPExecution" }],
    "afterMCPExecution": [{ "command": ".cursor/hooks/forward.sh afterMCPExecution" }],
    "afterFileEdit": [{ "command": ".cursor/hooks/forward.sh afterFileEdit" }],
    "subagentStart": [{ "command": ".cursor/hooks/forward.sh subagentStart" }],
    "subagentStop": [{ "command": ".cursor/hooks/forward.sh subagentStop" }],
